# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=http://localhost:11434  # For Ollama or proxy

# DeepSeek cloud (https://platform.deepseek.com/)
