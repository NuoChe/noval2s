# LLM Configuration — V2 Multi-Model

# Default model (one of: openai-gpt-4o-mini, qwen-plus, zhipu-glm-5.1, kimi-moonshot-32k, deepseek-chat)
DEFAULT_MODEL_ID=openai-gpt-4o-mini

# Provider API Keys (configure at least one; unavailable models are hidden in Web UI)
OPENAI_API_KEY=
LLM_API_KEY=                    # backward compatible alias for OPENAI_API_KEY
DASHSCOPE_API_KEY=              # 通义千问 (DashScope compatible mode)
ZAI_API_KEY=                    # 智谱 GLM
MOONSHOT_API_KEY=               # Kimi (Moonshot)
DEEPSEEK_API_KEY=               # DeepSeek

# Backward compatible v1 settings (CLI)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=http://localhost:11434  # For Ollama or proxy

# DeepSeek (also selectable in Web UI as deepseek-chat)
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# Auth Demo (required for Web UI convert)
AUTH_SECRET=change-me-in-production
# AUTH_DEMO_USERS=admin@demo.local:demo123

# Processing Limits
MAX_CHAPTERS=20
MAX_WORDS=100000

# Prompt version (written to output meta)
PROMPT_VERSION=v1.0
